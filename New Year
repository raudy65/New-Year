<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Novoroční přání 2026</title>

<style>
html,body{
  margin:0;
  padding:0;
  height:100%;
  background:#000;
}

#wrap{
  width:100%;
  height:100%;
  display:flex;
  align-items:center;
  justify-content:center;
}

#card{
  position:relative;
}

#card img{
  display:block;
  max-width:100vw;
  max-height:100vh;
  width:auto;
  height:auto;
}

canvas{
  position:absolute;
  inset:0;
  pointer-events:none;
}

.zone{
  position:absolute;
  cursor:pointer;
}

/* popup */
#popup{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.65);
  display:none;
  align-items:center;
  justify-content:center;
}
#popup.show{display:flex;}

#popup div{
  background:rgba(30,20,10,.9);
  border:1px solid gold;
  padding:28px 32px;
  border-radius:20px;
  color:#fff;
  text-align:center;
  max-width:340px;
  box-shadow:0 0 30px rgba(255,215,120,.6);
  transform:scale(.85);
  opacity:0;
  transition:.35s ease;
}
#popup.show div{
  transform:scale(1);
  opacity:1;
}
</style>
</head>

<body>

<div id="wrap">
  <div id="card">
    <img id="img" src="pozadi.png" alt="Novoroční přání">
    <canvas id="c"></canvas>

    <div id="love" class="zone"></div>
    <div id="luck" class="zone"></div>
    <div id="health" class="zone"></div>
    <div id="secret" class="zone"></div>
  </div>
</div>

<div id="popup">
  <div>
    <h2 id="pt"></h2>
    <p id="pp"></p>
  </div>
</div>

<script>
const img = document.getElementById("img");
const canvas = document.getElementById("c");
const ctx = canvas.getContext("2d");

/* 🔒 KALIBROVANÉ SOUŘADNICE (Z TVÉHO KLIKU) */
const zones = {
  love:   { x:0.1513840830449827, y:0.7612456747404844 },
  luck:   { x:0.3762975778546713, y:0.7554786620530565 },
  health: { x:0.6133217993079585, y:0.7600922722029988 },
  secret: { x:0.8434256055363322, y:0.7589388696655133 }
};

/* velikost klikací oblasti kolem středu ikony */
const ZONE_SIZE = 0.16; // 16 % šířky obrázku

function positionZones(){
  const rect = img.getBoundingClientRect();
  canvas.width = rect.width;
  canvas.height = rect.height;

  Object.keys(zones).forEach(id=>{
    const z = zones[id];
    const el = document.getElementById(id);
    const size = rect.width * ZONE_SIZE;

    el.style.left   = (rect.width  * z.x - size/2) + "px";
    el.style.top    = (rect.height * z.y - size/2) + "px";
    el.style.width  = size + "px";
    el.style.height = size + "px";
  });
}

img.onload = positionZones;
window.addEventListener("resize", positionZones);

/* ohňostroj */
let parts=[];
function burst(x,y,col){
  for(let i=0;i<120;i++){
    const a=Math.random()*Math.PI*2;
    const s=Math.random()*4+2;
    parts.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,l:70,c:col});
  }
}
function draw(){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  parts.forEach((p,i)=>{
    p.x+=p.vx; p.y+=p.vy; p.vy+=.03; p.l--;
    ctx.fillStyle=p.c;
    ctx.beginPath();
    ctx.arc(p.x,p.y,2,0,Math.PI*2);
    ctx.fill();
    if(p.l<=0) parts.splice(i,1);
  });
  requestAnimationFrame(draw);
}
draw();

setTimeout(()=>burst(canvas.width/2, canvas.height/3, "gold"),600);

/* přání */
const popup=document.getElementById("popup");
const pt=document.getElementById("pt");
const pp=document.getElementById("pp");

const wishes={
  love:["❤️ Láska","Ať je nový rok plný lásky a krásných chvil.","pink"],
  luck:["🍀 Štěstí","Ať tě v roce 2026 provází štěstí na každém kroku.","lime"],
  health:["💪 Zdraví","Přejeme pevné zdraví, sílu a energii.","orange"],
  secret:["😈 Tajné přání","To nejdůležitější přání znáš jen ty sám… 😉","violet"]
};

function openWish(k){
  pt.textContent=wishes[k][0];
  pp.textContent=wishes[k][1];
  popup.classList.add("show");
  burst(canvas.width/2, canvas.height/3, wishes[k][2]);
}

love.onclick=()=>openWish("love");
luck.onclick=()=>openWish("luck");
health.onclick=()=>openWish("health");
secret.onclick=()=>openWish("secret");

popup.onclick=()=>popup.classList.remove("show");
</script>

</body>
</html>
